# Free key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Newest Flash model on the free tier (see DECISIONS.md). Change here, not in code.
GEMINI_MODEL=gemini-3.8-flash
# Free key from https://www.gstinapi.in/register
GSTINAPI_KEY=
# Optional: live bank penny-drop. Leave empty to use two-person finance confirmation.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# Milliseconds each stage is held on screen so the live run view is readable. 0 disables.
VENDORCHECK_PACING_MS=700

# Document reader provider (first one with a key is used unless READER_PROVIDER is set): groq | openrouter | gemini
READER_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# OpenRouter: comma-separated keys are tried in order (fails over when one is out of credit)
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemini-3.8-flash
